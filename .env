# Control mode: "finger" or "body"
CONTROL_MODE=body

# Swipe sensitivity (lower = more sensitive)
SWIPE_THRESHOLD=0.04

# Cooldown between actions in seconds
COOLDOWN_TIME=0.10

# Buffer size for gesture smoothing (more = smoother but slower reaction)
BUFFER_SIZE=2

# MediaPipe detection confidence (0.0 - 1.0)
DETECTION_CONFIDENCE=0.5
TRACKING_CONFIDENCE=0.5

# Game URL
GAME_URL=https://poki.com/en/g/subway-surfers

# Camera Source Index (0 = Default/Built-in, 1 = External USB Camera, 2 = DroidCam, etc.)
CAMERA_INDEX=0
